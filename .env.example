# Application
APP_NAME=DownloadWebService
APP_ENV=development
LOG_LEVEL=INFO
# json (default, for Docker) or text (readable local console)
LOG_FORMAT=json

# External catalog API (обязательно заменить на значения из тестового задания)
# База без завершающего слэша. Клиент ходит на:
#   GET  {EXTERNAL_API_BASE_URL}/api/files/names          → {"file_names": [...]}
#   POST {EXTERNAL_API_BASE_URL}/api/files/download       body: {"file_names": [...]} ≤3 → ZIP
#   POST {EXTERNAL_API_BASE_URL}/api/files/downloaded     body: {"file_names": [...]}
# Заголовок X-Candidate-Id обязателен для идентификации кандидата.
EXTERNAL_API_BASE_URL=https://example.com
X_CANDIDATE_ID=local-dev-candidate
EXTERNAL_API_TIMEOUT_SECONDS=30
EXTERNAL_API_MAX_ATTEMPTS=5
# Пауза между HTTP-запросами к каталогу (снижает риск 429/403)
EXTERNAL_API_MIN_INTERVAL_SECONDS=1.5

# Shared volume path inside api/worker containers
FILES_STORAGE_PATH=/data/files

# PostgreSQL
POSTGRES_USER=dws
POSTGRES_PASSWORD=dws_secret
POSTGRES_DB=dws
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://dws:dws_secret@postgres:5432/dws

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_USER=dws
RABBITMQ_PASSWORD=dws_secret
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://dws:dws_secret@rabbitmq:5672//
CELERY_BROKER_URL=amqp://dws:dws_secret@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
